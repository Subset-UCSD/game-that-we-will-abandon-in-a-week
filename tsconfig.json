{
	"compilerOptions": {
		"lib": ["ESNext", "dom"],
		"types": ["node"],
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"paths": {
			"@client/*": ["./client/*"],
			"@server/*": ["./server/*"],
			"@common": ["games/caveGame/common"],
			// should we remove this and encourage @common instead
			"@common/*": ["games/caveGame/common/*"]
		},
		"noEmit": true
	}
}
