{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "tab"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "assist": {
    "enabled": true
  }
}